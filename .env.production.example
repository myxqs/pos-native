# Copy to .env.production and replace every placeholder. Never commit that file.
POSTGRES_DB=pos_native
POSTGRES_USER=pos_native
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POS_SERVICE_TOKEN=replace-with-a-random-token-of-at-least-43-characters
POS_SERVICE_TOKEN_ID=nativepos-local-service
POS_PORT=3000
POS_BACKUP_ROOT=C:/Users/replace-me/NativePOS-Backups
POS_BACKUP_RETENTION=14
