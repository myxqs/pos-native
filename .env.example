# Copy to .env for local Docker-backed development. Never commit real secrets.
POSTGRES_DB=pos_native
POSTGRES_USER=pos_native
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://pos_native:replace-with-a-long-random-password@localhost:5432/pos_native
POS_WEB_ASSET_ROOT=C:/path/to/packaged/apps/web
POS_ASSET_ROOT=C:/path/to/local/asset-root
POS_LISTEN_HOST=127.0.0.1
POS_PORT=3000
